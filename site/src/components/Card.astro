---
import type { Manifest } from '../lib/catalogue';
import { scientificContent } from '../lib/data';
import Preview from './Preview.astro';
import { searchTextFor } from '../lib/filter';

const { item, index, headingLevel = 3 } = Astro.props as { item: Manifest; index: number; headingLevel?: 2 | 3 };
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const searchText = searchTextFor(item, scientificContent[item.content]);
---
<article
  class="collection-entry"
  data-category={item.category}
  data-status={item.status}
  data-tags={item.tags.join('|')}
  data-search={searchText}
>
  <div class="entry-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
  <Preview item={item} className="entry-preview" />
  <div class="entry-copy">
    <div class="entry-kicker">
      <span>{item.category}</span>
      <span class:list={['status', item.status === 'playable' ? 'status-live' : 'status-candidate']}>
        {item.status === 'playable' ? 'Playable here' : 'External candidate'}
      </span>
    </div>
    <Heading><a href={`/simulations/${item.id}/`}>{item.title}</a></Heading>
    <p>{item.summary}</p>
    <div class="entry-foot">
      <span>{item.authors.map(author => author.name).join(', ')}</span>
      <span class="entry-arrow" aria-hidden="true">↗</span>
    </div>
  </div>
</article>
