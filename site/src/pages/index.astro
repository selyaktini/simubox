---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Preview from '../components/Preview.astro';
import { catalogue } from '../lib/data';
import { categories } from '../lib/catalogue';

const ordered = [...catalogue].sort((a, b) => Number(b.status === 'playable') - Number(a.status === 'playable'));
const featured = ordered[0];
const availableCategories = categories.filter(category => catalogue.some(item => item.category === category));
---
<Base title="An atlas of scientific experiments">
  <section class="home-intro site-shell" aria-labelledby="intro-title">
    <div class="intro-copy">
      <p class="section-index">SIMUBOX / OPEN LABORATORY</p>
      <h1 id="intro-title">An atlas of models you can <em>test.</em></h1>
      <p class="intro-lede">Change the variables. Watch the system respond. Read the equations and assumptions beside the experiment.</p>
      <div class="intro-actions">
        <a class="action-primary" href="/simulations/">Explore the collection <span aria-hidden="true">↗</span></a>
        <a class="action-text" href={`/simulations/${featured.id}/`}>Open the Lorenz experiment <span aria-hidden="true">→</span></a>
      </div>
      <p class="intro-footnote">One playable model. Two external projects under integration review.</p>
    </div>
    <div class="intro-figure">
      <Preview item={featured} className="hero-preview" />
      <div class="figure-note"><span>FIG. 01</span><span>Computed from the Lorenz equations · RK4, Δt = 0.005</span></div>
    </div>
  </section>

  <section class="collection-section site-shell" aria-labelledby="collection-heading">
    <div class="section-head">
      <div><p class="section-index">THE COLLECTION / 003 ENTRIES</p><h2 id="collection-heading">Start with a model.</h2></div>
      <a class="action-text" href="/simulations/">All experiments <span aria-hidden="true">↗</span></a>
    </div>
    <div class="collection-list">{ordered.map((item, index) => <Card item={item} index={index} />)}</div>
  </section>

  <section class="field-section site-shell" aria-labelledby="field-heading">
    <div><p class="section-index">FIELD INDEX</p><h2 id="field-heading">Browse by discipline</h2></div>
    <div class="field-index">
      {availableCategories.map((category, index) => (
        <a href={`/simulations/?category=${encodeURIComponent(category)}`}>
          <span class="field-number">{String(index + 1).padStart(2, '0')}</span>
          <span>{category}</span>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="provenance-section site-shell" aria-labelledby="provenance-heading">
    <p class="section-index">OPEN NOTEBOOK</p>
    <h2 id="provenance-heading">The model is part of the explanation.</h2>
    <div>
      <p>SimuBox places runnable experiments, scientific notes and source provenance together. External work remains a candidate until its build, license and browser behavior are reviewed.</p>
      <a class="action-text" href="/about/">How the atlas works <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>
