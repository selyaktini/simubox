---
import Base from '../../layouts/Base.astro';
import Preview from '../../components/Preview.astro';
import { catalogue, scientificContent } from '../../lib/data';
import { renderScientificMarkdown } from '../../lib/markdown';
import type { Manifest } from '../../lib/catalogue';

export function getStaticPaths() {
  return catalogue.map(item => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props as { item: Manifest };
const notes = renderScientificMarkdown(scientificContent[item.content]);
const playable = item.status === 'playable';
const playerUrl = playable ? (import.meta.env.DEV ? 'http://127.0.0.1:4322/index.html' : item.entryPoint) : undefined;
---
<Base title={item.title} description={item.summary}>
  <div class="site-shell detail-page">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/simulations/">Explore</a><span aria-hidden="true">/</span><span aria-current="page">{item.title}</span></nav>
    <header class="experiment-header">
      <div>
        <p class="section-index">{item.category.toUpperCase()} / {playable ? 'LIVE EXPERIMENT' : 'EXTERNAL CANDIDATE'}</p>
        <h1>{item.title}</h1>
        <p>{item.summary}</p>
      </div>
      <div class:list={['experiment-stamp', playable ? 'stamp-live' : 'stamp-candidate']}>
        <span class="stamp-symbol" aria-hidden="true">{playable ? '●' : '◇'}</span>
        <span>{playable ? 'PLAYABLE HERE' : 'SOURCE ONLY'}</span>
      </div>
    </header>

    {playable ? (
      <section class="workspace" id="workspace" aria-label="Interactive experiment">
        <div class="workspace-bar">
          <div><span class="workspace-label">01 / EXPERIMENT SURFACE</span><span class="workspace-model">Lorenz system · Canvas 2D</span></div>
          <button type="button" id="fullscreen" class="workspace-action" aria-label="Enter fullscreen experiment">Fullscreen <span aria-hidden="true">⤢</span></button>
        </div>
        <div class="player-wrap" id="player-wrap">
          <div id="loading" class="player-message" role="status">Loading experiment…</div>
          <iframe id="player" title={`${item.title} interactive experiment`} src={playerUrl} sandbox="allow-scripts" referrerpolicy="no-referrer" loading="eager"></iframe>
        </div>
        <p id="player-error" class="player-error" role="alert" hidden>Experiment unavailable. Check that the simulation service is running, then reload this page.</p>
        <div class="workspace-foot"><span>Fixed-step RK4 · Δt = 0.005</span><span>Controls and keyboard shortcuts are inside the player</span></div>
      </section>
    ) : (
      <section class="candidate-workspace" aria-labelledby="candidate-heading">
        <Preview item={item} className="candidate-preview" />
        <div class="candidate-message">
          <p class="section-index">INTEGRATION STATUS / CANDIDATE</p>
          <h2 id="candidate-heading">Study the source project</h2>
          <p>This project is indexed for scientific discovery. It is not yet playable inside SimuBox. Its artifact, license notices and isolated browser behavior need review before integration.</p>
          <a class="action-primary" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">Open source repository <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    )}

    <div class="reading-layout">
      <article class="scientific-notes" aria-label="Scientific explanation">
        <p class="section-index">SCIENTIFIC NOTES / {item.category.toUpperCase()}</p>
        <div class="prose"><Fragment set:html={notes} /></div>
      </article>
      <aside class="source-panel" aria-labelledby="source-heading">
        <p class="section-index">PROVENANCE</p>
        <h2 id="source-heading">Source record</h2>
        <dl>
          <div><dt>Authors</dt><dd>{item.authors.map((author, index) => <Fragment>{index > 0 ? ', ' : ''}{author.url ? <a href={author.url} target="_blank" rel="noopener noreferrer">{author.name}</a> : author.name}</Fragment>)}</dd></div>
          <div><dt>Repository</dt><dd><a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">View source ↗</a></dd></div>
          {item.sourceCommit && <div><dt>Revision</dt><dd><code>{item.sourceCommit}</code></dd></div>}
          <div><dt>License</dt><dd>{item.license === 'Pending' ? 'Original work · declaration pending owner approval' : item.license}</dd></div>
          <div><dt>Browser capability</dt><dd>{item.capabilities.join(', ')}</dd></div>
          <div><dt>Integration</dt><dd>{playable ? 'First-party · playable' : 'External candidate · source only'}</dd></div>
        </dl>
      </aside>
    </div>
  </div>
  <script src="../../lib/player.ts"></script>
</Base>
