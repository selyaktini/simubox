{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "vitest/globals",
      "vite/client"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "site/src/lib/**/*.ts",
    "simulations/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
